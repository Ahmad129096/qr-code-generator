{
  "name": "qr-code-generator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p workers/dynamic/tsconfig.json && vite build",
    "build:browser-package": "vite build --config packages/qr-browser/vite.config.ts && tsc -p packages/qr-browser/tsconfig.types.json",
    "worker:dev": "wrangler dev --config workers/dynamic/wrangler.toml",
    "worker:deploy": "wrangler deploy --config workers/dynamic/wrangler.toml",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview"
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.2",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.12",
    "wrangler": "^4.151.3"
  }
}
